# Copy to .env and fill it in. Never commit .env.
# Generate the two secrets below with:  pnpm cli generate-secrets
# (or, with the image built:  docker run --rm appmetrics:latest node dist/cli.mjs generate-secrets)

# --- Database --------------------------------------------------------------
# docker compose builds DATABASE_URL from POSTGRES_PASSWORD. Set DATABASE_URL
# yourself only when you run the app outside compose.
POSTGRES_PASSWORD=
# DATABASE_URL=postgres://appmetrics:your-password@localhost:5432/appmetrics

# --- The one login ---------------------------------------------------------
DASHBOARD_USER=admin
# Preferred: a hash, so the password itself is never in this file.
#   pnpm cli hash-password
# (or, with the image built:  docker run --rm -it appmetrics:latest node dist/cli.mjs hash-password)
DASHBOARD_PASSWORD_HASH=
# Or a plain password of 12+ characters. Set exactly one of the two.
DASHBOARD_PASSWORD=

# --- Secrets ---------------------------------------------------------------
# Signs session tokens and API tokens. 32+ random characters.
SESSION_SECRET=
# Encrypts the Partner API tokens stored in the database. 32 random bytes, base64.
# Losing it means re-entering your tokens; changing it does the same.
ENCRYPTION_KEY=

# --- Optional --------------------------------------------------------------
# DASHBOARD_USER above defaults to admin. The three secrets above are required.
# How often the worker pulls new events from Shopify (5 to 1440, default 60).
# SYNC_INTERVAL_MINUTES=60
# Set to false only for local development over plain http.
# COOKIE_SECURE=true
# Read the client address from X-Forwarded-For. Only behind a reverse proxy: it is off unless set,
# and compose.yaml sets it, because there the app can only be reached through the proxy.
# TRUST_PROXY=true
# How many reverse proxies sit in front of the app (Coolify's proxy is one; add one for Cloudflare).
# PROXY_HOPS=1
# Shows a banner and keeps the worker from calling Shopify. Used with: pnpm cli seed-demo
# DEMO_MODE=false
# Extra hosts allowed to call Server Actions. Read when the image is built. Usually not needed.
# ALLOWED_ORIGINS=
# Only with compose.local.yaml: the port published on 127.0.0.1 (default 3000).
# WEB_PORT=3000
